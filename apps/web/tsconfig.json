{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@patent/domain": ["../../packages/domain/src/index.ts"],
      "@patent/shared": ["../../packages/shared/src/index.ts"],
      "@patent/providers": ["../../packages/providers/src/index.ts"],
      "@patent/pipeline": ["../../packages/pipeline/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
