{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@patent/domain": ["../domain/src/index.ts"],
      "@patent/audit": ["../audit/src/index.ts"]
    }
  },
  "include": ["src"]
}
